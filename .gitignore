*.mat
*.pth
*.pt
*.npy
*.npz
*.safetensors
*.onnx
*.pkl
*.h5

# --- Python / environment artifacts ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
env/
venv/
ENV/

