# --- Annotation data (JSON + images, wherever they live: annotations/,
#     annotations_drone/, all_annotations/, drone_extraction/linm_ref.json,
#     drone_extraction/*.png previews...). .py tools are never matched by
#     these globs, so annotate.py/assign_split.py/extract_linm.py etc. stay
#     tracked automatically. ---
*.json
!example_annotations.json
!all_annotations/annotations_wheat.json
!all_annotations/annotations_pea.json
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
*.tif
*.TIF
*.tiff
*.TIFF

# --- Prepared training data ---
pet_final/data*/

# --- Generated outputs ---
pet_final/outputs*/
PET/outputs*/
pet_final_out/
PET_jobs/
*.log
*.out

